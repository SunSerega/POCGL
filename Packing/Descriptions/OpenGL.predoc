    public static function RotatePrefixXY(radians: real): Mtr2x2f;
    begin
      var a_sin: single := Sin(radians);
      var a_cos: single := Cos(radians);
      Result.Col0 := new Vec2f(+a_cos, +a_sin);
      Result.Col1 := new Vec2f(-a_sin, +a_cos);
    end;
