    new Vec4f(m1.Row0*m2.Col2, m1.Row1*m2.Col2, m1.Row2*m2.Col2, m1.Row3*m2.Col2)
  );

function operator implicit(m: Mtr4f): Mtr4d; extensionmethod := Mtr4d.FromCols(m.Col0, m.Col1, m.Col2, m.Col3);
